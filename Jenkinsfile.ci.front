pipeline {
    agent any

    tools {
        nodejs 'Node20'
    }

    environment {
        CD_FRONT_JOB = 'CD-Front'
        // true = bloque si Quality Gate Sonar échoue (webhook Sonar->Jenkins requis).
        SONAR_WAIT_QUALITY_GATE = "${env.SONAR_WAIT_QUALITY_GATE ?: 'true'}"
        GIT_REPO_URL = 'https://github.com/medamin87737/-PIfullstackJS-4TWIN6-2026-EspritHub.git'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                echo "🔄 CI FRONT – Checkout du repository (clone superficiel + buffer HTTP, retries)..."
                script {
                    if (isUnix()) {
                        retry(3) {
                            deleteDir()
                            sh '''
                                set -e
                                git -c http.postBuffer=524288000 \\
                                    -c http.lowSpeedLimit=1000 \\
                                    -c http.lowSpeedTime=600 \\
                                    clone --depth 1 --single-branch --branch main \\
                                    "$GIT_REPO_URL" .
                            '''
                        }
                    } else {
                        retry(3) {
                            deleteDir()
                            bat '''
                                git -c http.postBuffer=524288000 -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=600 clone --depth 1 --single-branch --branch main %GIT_REPO_URL% .
                            '''
                        }
                    }
                }
            }
        }

        stage('Install (Frontend)') {
            steps {
                echo "📦 Installation des dépendances frontend..."
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm ci || npm install'
                            sh 'npm install --no-save --include=optional @rollup/rollup-linux-x64-gnu || true'
                        } else {
                            bat 'npm ci || npm install'
                        }
                    }
                }
            }
        }

        stage('Test (Frontend)') {
            steps {
                echo "🧪 Exécution des tests frontend..."
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'if npm run | grep -q "test:ci"; then npm run test:ci; else npm run test; fi'
                        } else {
                            bat 'npm run test:ci || npm run test'
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis (Frontend)') {
            when {
                expression { return isUnix() } // simplifie: analyse Sonar sur agent Linux
            }
            steps {
                echo "📊 Analyse SonarQube frontend..."
                dir('frontend') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        // Le nom "SonarQubeServer" doit correspondre à la config de ton serveur dans Jenkins
                        withSonarQubeEnv('SonarQubeServer') {
                            sh "\"${scannerHome}/bin/sonar-scanner\""
                        }
                    }
                }
            }
        }

        stage('Sonar Quality Gate') {
            when {
                allOf {
                    expression { return isUnix() }
                    expression { return env.SONAR_WAIT_QUALITY_GATE == 'true' }
                }
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build (Frontend)') {
            steps {
                echo "🏗 Build frontend..."
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh 'npm run build'
                        } else {
                            bat 'npm run build'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'frontend/coverage/**, frontend/reports/**', allowEmptyArchive: true
            junit testResults: 'frontend/reports/junit.xml', allowEmptyResults: true, keepLongStdio: true
        }
        success {
            echo "✅ CI FRONT terminé avec succès"
            echo "🚀 Déclenchement automatique du pipeline CD frontend..."
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    build job: env.CD_FRONT_JOB, wait: false
                }
            }
        }
        failure { echo "❌ CI FRONT échoué" }
    }
}

